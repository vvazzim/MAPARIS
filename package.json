{
  "name": "paris-security-pulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Paris Security Pulse - Plateforme temps réel de cartographie Safe / Pas Safe des événements à Paris",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspaces --if-present",
    "install:all": "npm install"
  },
  "keywords": [
    "paris",
    "security",
    "real-time",
    "fastify",
    "react",
    "socketio",
    "leaflet",
    "osint"
  ],
  "author": "Paris Security Pulse Team",
  "license": "MIT"
}
